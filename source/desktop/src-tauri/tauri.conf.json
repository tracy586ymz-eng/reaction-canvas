{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reaction Canvas",
  "version": "0.1.0",
  "identifier": "com.tracy.reactioncanvas",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{"label":"main","title":"Reaction Canvas","width":1120,"height":800,"minWidth":600,"minHeight":500,"visible":true}],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": true, "targets": ["app","dmg"], "category": "Productivity", "shortDescription": "截图、交流与化学反应图示", "resources":["../licenses/"], "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"], "macOS": {"minimumSystemVersion":"12.0"}, "windows":{"nsis":{"displayLanguageSelector":true,"languages":["SimpChinese","English"],"installMode":"currentUser"}} }
}
